# Keep mock mode enabled until sandbox testing, webhook verification, and merchant approval are complete.
FLW_MODE=mock

# Flutterwave v4 server credentials. Never expose these through VITE_ variables.
FLW_V4_CLIENT_ID=
FLW_V4_CLIENT_SECRET=
FLW_V4_ENCRYPTION_KEY=
FLW_V4_WEBHOOK_SECRET_HASH=
FLW_PAYMENT_SESSION_SECRET=

FLW_V4_TOKEN_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLW_V4_BASE_URL=https://developersandbox-api.flutterwave.com
FLW_VA_BANK_CODE=
PUBLIC_APP_URL=http://127.0.0.1:5173

# Optional trusted prices for mobile-money currencies, resolved only on the server.
# Example: {"smart-contract-security":{"GHS":4000,"KES":33000}}
FLW_MOBILE_MONEY_PRICES_JSON={}

# Optional private workbook locations.
ADMISSIONS_WORKBOOK_PATH=
PAYMENTS_WORKBOOK_PATH=
